{
    "name": "bluetab",
    "version": "1.0.4",
    "private": true,
    "description": "Bluetab: a calm, private tab manager for Chrome and Firefox",
    "license": "AGPL-3.0-only",
    "homepage": "https://bluetab.in",
    "repository": {
        "type": "git",
        "url": "https://github.com/supertrydev/bluetab.git"
    },
    "bugs": {
        "url": "https://github.com/supertrydev/bluetab/issues"
    },
    "type": "module",
    "scripts": {
        "dev": "vite build --mode development --watch",
        "build": "vite build && node scripts/ci/check-content-scripts.cjs",
        "package:cws": "npm run build && node scripts/package-cws.cjs",
        "build:firefox": "BLUETAB_BROWSER=firefox vite build && node scripts/ci/check-content-scripts.cjs dist-firefox",
        "lint:firefox": "web-ext lint --source-dir dist-firefox --self-hosted=false",
        "package:amo": "npm run build:firefox && npm run lint:firefox && node scripts/package-amo.cjs",
        "test": "jest",
        "lint": "eslint src",
        "type-check": "tsc --noEmit",
        "ci:turkish": "bash scripts/ci/check-turkish-chars.sh",
        "ci:forbidden-words": "bash scripts/ci/check-forbidden-words.sh",
        "ci:all": "npm run ci:turkish && npm run ci:forbidden-words && npm run lint && npm run type-check && npm test -- --runInBand && npm run build && npm audit --omit=dev"
    },
    "dependencies": {
        "@ai-sdk/mcp": "^1.0.36",
        "@ai-sdk/react": "^3.0.118",
        "@assistant-ui/react": "^0.12.17",
        "@assistant-ui/react-ai-sdk": "^1.3.13",
        "@assistant-ui/react-ui": "^0.2.1",
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/sortable": "^10.0.0",
        "@dnd-kit/utilities": "^3.2.2",
        "@mozilla/readability": "^0.6.0",
        "@radix-ui/react-avatar": "^1.1.11",
        "@radix-ui/react-collapsible": "^1.1.12",
        "@radix-ui/react-dialog": "^1.1.15",
        "@radix-ui/react-direction": "1.1.1",
        "@radix-ui/react-dropdown-menu": "^2.1.16",
        "@radix-ui/react-label": "^2.1.7",
        "@radix-ui/react-radio-group": "^1.3.8",
        "@radix-ui/react-scroll-area": "^1.2.10",
        "@radix-ui/react-select": "^2.2.6",
        "@radix-ui/react-separator": "^1.1.8",
        "@radix-ui/react-slot": "^1.2.4",
        "@radix-ui/react-switch": "^1.2.6",
        "@radix-ui/react-tabs": "^1.1.13",
        "@radix-ui/react-toast": "^1.2.15",
        "@radix-ui/react-tooltip": "^1.2.8",
        "ai": "^6.0.116",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "dompurify": "^3.4.11",
        "fast-xml-parser": "^5.7.2",
        "framer-motion": "^12.23.24",
        "i18next": "^26.3.4",
        "idb": "^8.0.3",
        "lucide-react": "^0.563.0",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "react-i18next": "^17.0.8",
        "react-responsive-masonry": "^2.7.1",
        "sonner": "^2.0.7",
        "tailwind-merge": "^3.3.1",
        "tailwindcss-animate": "^1.0.7",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@types/chrome": "^0.0.246",
        "@types/dompurify": "^3.0.5",
        "@types/jest": "^30.0.0",
        "@types/node": "^24.10.1",
        "@types/react": "^18.2.0",
        "@types/react-dom": "^18.2.0",
        "@vitejs/plugin-react": "^5.2.0",
        "autoprefixer": "^10.4.14",
        "baseline-browser-mapping": "^2.10.40",
        "browserslist": "^4.28.4",
        "caniuse-lite": "^1.0.30001800",
        "esbuild": "^0.28.2",
        "eslint": "^9.39.5",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^5.2.0",
        "globals": "^17.14.0",
        "jest": "^30.2.0",
        "jest-environment-jsdom": "^30.2.0",
        "postcss": "^8.5.15",
        "tailwindcss": "^3.3.0",
        "ts-jest": "^29.4.6",
        "typescript": "^5.1.0",
        "typescript-eslint": "^8.72.1",
        "vite": "^7.3.7",
        "web-ext": "10.8.0"
    },
    "overrides": {
        "minimatch": "^11.0.4",
        "glob": "^14.0.3",
        "deepmerge": "4.1.0",
        "multimatch": "^8.0.0"
    }
}
