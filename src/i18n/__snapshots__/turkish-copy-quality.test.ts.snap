  "components.sync.exclusionsItems.archiveDescription": {
    "english": "Long-term archives, encrypted archive payloads, and saved offline articles are not copied between devices.",
    "turkish": "Uzun süreli arşivler, şifreli arşiv verileri ve çevrimdışı makaleler cihazlar arasında kopyalanmaz.",
