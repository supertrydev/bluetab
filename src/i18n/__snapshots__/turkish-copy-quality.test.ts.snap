  "components.sync.exclusionsItems.browserTitle": {
    "english": "Browser permissions and local UI state",
    "turkish": "Tarayıcı izinleri ve yerel arayüz durumu",
  },
  "components.sync.exclusionsItems.integrationsDescription": {
    "english": "OAuth tokens, reconnect flags, provider sessions, and integration account credentials stay on the device.",
    "turkish": "OAuth tokenları, yeniden bağlanma işaretleri, sağlayıcı oturumları ve entegrasyon hesap bilgileri cihazda kalır.",
