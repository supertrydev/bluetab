    "turkish": "Arşiv depolaması ve çevrimdışı okumalar",
  },
  "components.sync.exclusionsItems.browserDescription": {
    "english": "Site access, history permission, onboarding flags, sidebar position, sync queues, and device setup metadata are per-device.",
    "turkish": "Site erişimi, geçmiş izni, ilk kullanım işaretleri, kenar çubuğu konumu, senkronizasyon kuyrukları ve cihaz kurulum bilgileri cihaza özeldir.",
