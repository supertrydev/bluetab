  "components.sync.exclusionsItems.integrationsTitle": {
    "english": "Integration tokens and account sessions",
    "turkish": "Entegrasyon tokenları ve hesap oturumları",
  },
  "components.sync.exclusionsItems.rssDescription": {
    "english": "Notification preferences sync, but feed URLs, fetched articles, read/starred state, and cached reader content stay local.",
    "turkish": "Bildirim tercihleri senkronize edilir; feed URL’leri, alınan makaleler, okundu/yıldızlı durumu ve önbellekteki içerik yerel kalır.",
