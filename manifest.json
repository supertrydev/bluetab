{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "version": "1.0.6",
  "key": "",
  "description": "__MSG_appDescription__",
  "default_locale": "en",
  "permissions": [
    "tabs",
    "tabGroups",
    "storage",
    "unlimitedStorage",
    "commands",
    "contextMenus",
    "activeTab",
    "windows",
    "notifications",
    "identity",
    "alarms",
    "sidePanel",
    "declarativeNetRequest",
    "favicon",
    "clipboardWrite",
    "offscreen",
    "scripting"
  ],
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "host_permissions": [
    "https://supertry.net/*"
  ],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "web_accessible_resources": [
    {
      "resources": ["src/assets/*", "src/blocked/*", "src/onboarding/*"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],
  "omnibox": {
    "keyword": "bt"
  },
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "homepage_url": "https://bluetab.in",
  "action": {
    "default_icon": {
      "16": "src/assets/icon16.png",
      "32": "src/assets/icon32.png",
      "48": "src/assets/icon48.png",
      "64": "src/assets/icon48.png",
      "128": "src/assets/icon128.png",
      "256": "src/assets/icon128.png"
    }
  },
  "icons": {
    "16": "src/assets/icon16.png",
    "32": "src/assets/icon32.png",
    "48": "src/assets/icon48.png",
    "64": "src/assets/icon48.png",
    "128": "src/assets/icon128.png",
    "256": "src/assets/icon128.png"
  },
  "optional_permissions": ["history", "bookmarks"],
  "options_page": "src/options/index.html",
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+T"
      },
      "description": "__MSG_commandActivate__"
    },
    "save-all-tabs": {
      "suggested_key": {
        "default": "Alt+S"
      },
      "description": "__MSG_commandSaveAllTabs__"
    },
    "save-current-tab": {
      "description": "__MSG_commandSaveCurrentTab__"
    },
    "restore-last-group": {
      "description": "__MSG_commandRestoreLastGroup__"
    },
    "open-manager": {
      "suggested_key": {
        "default": "Alt+B"
      },
      "description": "__MSG_commandOpenManager__"
    },
    "brain-dump": {
      "suggested_key": {
        "default": "Alt+Q"
      },
      "description": "__MSG_commandBrainDump__"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
